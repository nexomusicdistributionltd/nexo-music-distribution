# NEXO Music Distribution — environment template
# Copy to .env.local and fill in values from your Supabase project.
# Never commit real secrets. Service role must NEVER use NEXT_PUBLIC_ prefix.
#
# Note: some earlier briefs mentioned VITE_* variables. This app is Next.js
# and uses NEXT_PUBLIC_* for browser-exposed values.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (optional) — admin tooling / privileged jobs. Do not expose to the client.
SUPABASE_SERVICE_ROLE_KEY=


# Distribution provider (server-only). When unset → NotConnected / Unavailable.
# Never commit real secrets. Never expose via NEXT_PUBLIC_*.
PROVIDER_NAME=
PROVIDER_API_KEY=
PROVIDER_API_BASE_URL=
PROVIDER_WEBHOOK_SECRET=

# Optional external catalog discovery (migration). Unset ⇒ unavailable (no invented catalog).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
APPLE_MUSIC_TOKEN=
APPLE_MUSIC_KEY_ID=
EXTERNAL_CATALOG_API_KEY=
