# NEXO Music Distribution — environment template (Batch 8)
# Copy to .env.local and fill values. Never commit real secrets.
# Service-role / provider / payment / webhook secrets must NEVER use NEXT_PUBLIC_*.
#
# Production Site URL (canonical): https://nexomusicdistribution.com
# MANUAL CONFIG REQUIRED in Supabase Dashboard → Authentication → URL Configuration:
#   Site URL: https://nexomusicdistribution.com
#   Redirect URLs:
#     https://nexomusicdistribution.com/**
#     https://nexomusicdistribution.com/auth/callback
#     https://nexomusicdistribution.com/auth/confirm
#     https://nexomusicdistribution.com/reset-password
# Auth email links must use this domain — never localhost or nexomusicdistro.space
# (nexomusicdistro.space is Zoho SMTP From only). This app cannot change the dashboard.

# ── Public (browser-safe) ──────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://nexomusicdistribution.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Supabase server-only ───────────────────────────────────────────
# Privileged admin / jobs / webhooks. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
# Direct DB password for migration apply via pooler (ops only; never in Next.js runtime).
# SUPABASE_DB_PASSWORD=

# ── Distribution provider (server-only) ────────────────────────────
# When unset → NotConnected / UNAVAILABLE. Never invent LIVE delivery.
PROVIDER_NAME=
PROVIDER_API_KEY=
PROVIDER_API_BASE_URL=
PROVIDER_WEBHOOK_SECRET=

# ── External catalog discovery / migration (optional, server-only) ─
# Unset ⇒ unavailable (no invented catalog).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
APPLE_MUSIC_TOKEN=
APPLE_MUSIC_KEY_ID=
EXTERNAL_CATALOG_API_KEY=

# ── Payment provider (server-only) ─────────────────────────────────
# When unset or no live adapter → NotConnected / UNAVAILABLE.
# Never invent PAID payouts. Never expose via NEXT_PUBLIC_*.
PAYMENT_PROVIDER_NAME=
PAYMENT_PROVIDER_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# ── Royalty report provider (server-only) ──────────────────────────
# Unset ⇒ import sources UNAVAILABLE.
ROYALTY_PROVIDER_NAME=
ROYALTY_PROVIDER_API_KEY=
ROYALTY_PROVIDER_WEBHOOK_SECRET=

# ── FX (server-only) ───────────────────────────────────────────────
# Unset ⇒ FX UNAVAILABLE (no silent conversion).
FX_PROVIDER_NAME=
FX_PROVIDER_API_KEY=

# ── Email / Zoho SMTP (server-only) ────────────────────────────────
# Newsletter + outbound use Nexo Zoho Mail SMTP (nodemailer). Never mark SENT without a real message id.
# Live Auth SMTP: smtp.zoho.com:465 — From: Nexo Music Distribution LTD <contact@nexomusicdistro.space>
EMAIL_PROVIDER=smtp
EMAIL_FROM=Nexo Music Distribution LTD <contact@nexomusicdistro.space>
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=contact@nexomusicdistro.space
SMTP_PASSWORD=
# SMTP_PASS=                 # alternate password var (optional)
# ZOHO_SMTP_APP_PASSWORD=    # ops secret store; if set and SMTP_HOST empty → smtp.zoho.com (Zoho Mail SMTP)
# RESEND_API_KEY=            # unused for newsletter (kept commented; do not prefer)

# ── Misc webhook / cron secrets (server-only) ──────────────────────
CRON_SECRET=
INTERNAL_JOB_SECRET=

# ── DDEX / ERN 4.3.2 (server-only) ─────────────────────────────────
# Sender Party Id / DPID. NEVER use NEXT_PUBLIC_*. NEVER put DPID in the frontend.
# Production server-only value is PA-DPIDA-2026021501-H — set it in host secrets, not the client.
# This file keeps a placeholder pattern only:
NEXO_DPID=PA-DPIDA-YYYYMMDDNN-X
# Optional display name override (defaults to NEXO MUSIC DISTRIBUTION LTD)
# NEXO_DDEX_SENDER_NAME=
# NO authorized DSP recipient DPID exists. Do NOT invent Spotify/Apple/etc. Party Ids.
# Leave unset until a legitimate DSP recipient is issued. Production delivery stays
# disabled without NEXO_DDEX_RECIPIENT_DPID (transport remains NotConnected).
# Internal fixtures may use a clearly isolated TEST recipient only (src/lib/ddex/__fixtures__).
NEXO_DDEX_RECIPIENT_DPID=
NEXO_DDEX_RECIPIENT_NAME=
NEXO_DDEX_RECIPIENT_KEY=
# Set true only for an explicitly configured isolated TEST recipient (MessageControlType=TestMessage).
# NEXO_DDEX_TEST_RECIPIENT=false
# NEXO_DDEX_MESSAGE_CONTROL=TestMessage
