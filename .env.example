# NEXO Music Distribution — environment template
# Copy to .env.local and fill in values from your Supabase project.
# Never commit real secrets. Service role must NEVER use NEXT_PUBLIC_ prefix.
#
# Note: some earlier briefs mentioned VITE_* variables. This app is Next.js
# and uses NEXT_PUBLIC_* for browser-exposed values.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (optional) — admin tooling / privileged jobs. Do not expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL (used in email CTAs)
NEXT_PUBLIC_SITE_URL=https://nexomusicdistro.space

# Outbound email (never commit real keys)
# EMAIL_PROVIDER=none|resend
EMAIL_PROVIDER=none
RESEND_API_KEY=
EMAIL_FROM=Nexo Music Distribution LTD <contact@nexomusicdistro.space>
# Optional SMTP stub (refuses fake success until transport wired)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false