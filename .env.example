# NEXO Music Distribution — environment template (Batch 8)
# Copy to .env.local and fill values. Never commit real secrets.
# Service-role / provider / payment / webhook secrets must NEVER use NEXT_PUBLIC_*.
#
# Production Site URL (canonical): https://nexomusicdistribution.com
# MANUAL CONFIG REQUIRED in Supabase Dashboard → Authentication → URL Configuration:
#   Site URL: https://nexomusicdistribution.com
#   Redirect URLs:
#     https://nexomusicdistribution.com
#     https://nexomusicdistribution.com/**
#     https://nexomusicdistribution.com/reset-password
#     https://nexomusicdistribution.com/auth/callback
#     https://nexomusicdistribution.com/auth/callback?next=/reset-password
#     https://nexomusicdistribution.com/auth/confirm
# App resetPasswordForEmail redirectTo is https://nexomusicdistribution.com/reset-password
# Live GoTrue recovery may deliver #access_token&refresh_token&type=recovery on that path.
# Also allow PKCE ?code= and OTP token_hash (forwarded from /reset-password to /auth/callback or /auth/confirm).
# Auth email links must use this domain — never localhost or nexomusicdistro.space
# (nexomusicdistro.space is Zoho SMTP From only). This app cannot change the dashboard.

# ── Public (browser-safe) ──────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://nexomusicdistribution.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Supabase server-only ───────────────────────────────────────────
# Privileged admin / jobs / webhooks / login email OTP. Never expose to the client.
# Netlify Site settings → Environment variables (Production + Deploy Previews as needed),
# then trigger a new deploy. Runtime Next.js API routes read these via process.env.
# Canonical name (required for login OTP 2FA, billing webhooks, privileged jobs):
SUPABASE_SERVICE_ROLE_KEY=
# Aliases accepted by the app if the canonical name is unset (still server-only):
#   SUPABASE_SERVICE_ROLE
#   SUPABASE_SECRET_KEY
# Do not paste the anon/public key here. Health reports checks.serviceRole=invalid if you do.
# Direct DB password for migration apply via pooler (ops only; never in Next.js runtime).
# SUPABASE_DB_PASSWORD=

# ── Distribution provider (server-only) ────────────────────────────
# When unset → NotConnected / UNAVAILABLE. Never invent LIVE delivery.
PROVIDER_NAME=
PROVIDER_API_KEY=
PROVIDER_API_BASE_URL=
PROVIDER_WEBHOOK_SECRET=

# OAuth distribution connection (server-only). Keep all real values in Netlify.
# The callback is shared with Nexo auth; provider OAuth must be distinguished by validated state.
DISTRIBUTION_API_BASE_URL=https://api.toolost.com/v1
DISTRIBUTION_AUTHORIZE_URL=https://toolost.com/oauth/authorize
DISTRIBUTION_TOKEN_URL=https://toolost.com/oauth/token
DISTRIBUTION_CLIENT_ID=
DISTRIBUTION_CLIENT_SECRET=
# Optional dedicated HMAC secret for OAuth state; falls back to DISTRIBUTION_CLIENT_SECRET.
# Required for AES-256-GCM encryption of stored OAuth access/refresh tokens (32+ chars).
DISTRIBUTION_TOKEN_ENCRYPTION_KEY=
DISTRIBUTION_OAUTH_STATE_SECRET=
DISTRIBUTION_REDIRECT_URI=https://nexomusicdistribution.com/api/admin/distribution/oauth/callback\n# Optional: set only to the exact scopes Too Lost has approved for this app.\n# DISTRIBUTION_OAUTH_SCOPE=

# ── External catalog discovery / migration (optional, server-only) ─
# Unset ⇒ unavailable (no invented catalog).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
APPLE_MUSIC_TOKEN=
APPLE_MUSIC_KEY_ID=
EXTERNAL_CATALOG_API_KEY=

# ── Payment provider (server-only) ─────────────────────────────────
# When unset or no live adapter → NotConnected / UNAVAILABLE.
# Never invent PAID payouts. Never expose via NEXT_PUBLIC_*.
PAYMENT_PROVIDER_NAME=
PAYMENT_PROVIDER_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# ── Royalty report provider (server-only) ──────────────────────────
# Unset ⇒ import sources UNAVAILABLE.
ROYALTY_PROVIDER_NAME=
ROYALTY_PROVIDER_API_KEY=
ROYALTY_PROVIDER_WEBHOOK_SECRET=

# ── FX (server-only) ───────────────────────────────────────────────
# Unset ⇒ FX UNAVAILABLE (no silent conversion).
FX_PROVIDER_NAME=
FX_PROVIDER_API_KEY=

# ── Email / Zoho SMTP (server-only) ────────────────────────────────
# Newsletter + outbound use Nexo Zoho Mail SMTP (nodemailer). Never mark SENT without a real message id.
# Public brand URL (website, CTA, email HTML): https://nexomusicdistribution.com
# Production From may remain the Zoho-verified mailbox below while public links stay .com.
# EMAIL_FROM is the override; SMTP_USER must stay the authenticated Zoho mailbox.
# Ops: only change EMAIL_FROM / SMTP_USER to a .com address after verifying that From domain in Zoho.
# Live Auth SMTP: smtp.zoho.com:465 — From: Nexo Music Distribution LTD <contact@nexomusicdistro.space>
EMAIL_PROVIDER=smtp
EMAIL_FROM=Nexo Music Distribution LTD <contact@nexomusicdistro.space>
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=contact@nexomusicdistro.space
SMTP_PASSWORD=
# SMTP_PASS=                 # alternate password var (optional)
# ZOHO_SMTP_APP_PASSWORD=    # ops secret store; if set and SMTP_HOST empty → smtp.zoho.com (Zoho Mail SMTP)
# IMAP_HOST=imap.zoho.com     # inbound Admin inbox (same mailbox credentials as SMTP)
# IMAP_PORT=993
# RESEND_API_KEY=            # unused (kept commented; do not prefer)

# ── Login email OTP (server-only) ──────────────────────────────────
# HMAC pepper for OTP hashes. Set this in Netlify as NEXO_OTP_PEPPER (recommended).
# If unset, SUPABASE_SERVICE_ROLE_KEY is used so rotating the service role also
# invalidates in-flight OTP hashes — prefer a dedicated pepper.
# Never expose via NEXT_PUBLIC_*. Never log plaintext OTP.
# Required with SUPABASE_SERVICE_ROLE_KEY + Zoho SMTP for production login 2FA.
# NEXO_OTP_PEPPER=


# ── Paddle Billing (subscriptions) ─────────────────────────────────
# FAIL LOUDLY if PADDLE_ENVIRONMENT is unset — there is no silent sandbox default.
# Must be sandbox or production. A Live client-side token (live_) requires production.
# Never put API keys or webhook secrets in NEXT_PUBLIC_*. Never commit real secrets.
# Do not use VITE_* — this app is Next.js App Router.
PADDLE_ENVIRONMENT=production
# Server API key. PADDLE_SANDBOX_API_KEY is accepted as an alias. NEVER NEXT_PUBLIC_*.
# Live catalog create needs product/price/notification_setting write on this key.
PADDLE_API_KEY=
# PADDLE_SANDBOX_API_KEY=
PADDLE_WEBHOOK_SECRET=
# Client-side token for Paddle.js (browser-safe). Set this in Netlify as:
#   NEXT_PUBLIC_PADDLE_CLIENT_TOKEN
# Not a Vite public env var. Live tokens start with live_; sandbox tokens with test_.
# This is the only Paddle value that belongs in the browser. Never expose
# PADDLE_API_KEY or PADDLE_WEBHOOK_SECRET via NEXT_PUBLIC_*.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# Product IDs — leave empty until real Live catalog IDs exist. Do not invent pro_ values.
PADDLE_PRODUCT_ARTIST_PRO=
PADDLE_PRODUCT_LABEL_STARTER=
PADDLE_PRODUCT_LABEL_PRO=
# Price IDs — server resolves these; the browser sends plan id + interval only.
# Leave empty until real Paddle Price IDs exist. Do not invent pri_ catalog IDs.
PADDLE_PRICE_ARTIST_PRO_MONTHLY=
PADDLE_PRICE_ARTIST_PRO_ANNUAL=
PADDLE_PRICE_LABEL_STARTER_MONTHLY=
PADDLE_PRICE_LABEL_STARTER_ANNUAL=
PADDLE_PRICE_LABEL_PRO_MONTHLY=
PADDLE_PRICE_LABEL_PRO_ANNUAL=
# Webhook destination (configure in Paddle once the API key can write notification settings):
#   https://nexomusicdistribution.com/api/webhooks/paddle
# Do NOT create GBP/EUR/AUD unit-price overrides until amounts are approved.

# ── DDEX / ERN 4.3.2 (server-only) ─────────────────────────────────
# Sender Party Id / DPID. NEVER use NEXT_PUBLIC_*. NEVER put DPID in the frontend.
# Locked production identity:
#   Party Name: NEXO MUSIC DISTRIBUTION LTD
#   DPID: PA-DPIDA-2026021501-H
# Host secrets should set NEXO_DDEX_DPID (alias NEXO_DPID is still read).
# This file keeps a placeholder pattern only:
NEXO_DDEX_PARTY_NAME=NEXO MUSIC DISTRIBUTION LTD
NEXO_DDEX_DPID=PA-DPIDA-YYYYMMDDNN-X
NEXO_DPID=PA-DPIDA-YYYYMMDDNN-X
# Optional display name override (defaults to NEXO MUSIC DISTRIBUTION LTD)
# NEXO_DDEX_SENDER_NAME=
# NEXO_DDEX_CONTACT is NOT configured in this repo. Do not invent a contact email.
# NEXO_DDEX_CONTACT=
# NO authorized DSP recipient DPID exists. Do NOT invent Spotify/Apple/etc. Party Ids.
# Leave unset until a legitimate DSP recipient is issued.
# The isolated Nexo Local Test Target loopbacks to the Nexo sender DPID (not a commercial DSP).
NEXO_DDEX_RECIPIENT_DPID=
NEXO_DDEX_RECIPIENT_NAME=
NEXO_DDEX_RECIPIENT_KEY=
# Set true only for an explicitly configured isolated TEST recipient (MessageControlType=TestMessage).
# NEXO_DDEX_TEST_RECIPIENT=false
# NEXO_DDEX_MESSAGE_CONTROL=TestMessage

# Fanlink resolvers (server-only; never expose keys client-side)
SONGPORT_API_KEY=
MUSICLINK_API_KEY=
